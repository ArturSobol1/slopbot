# Copy this file to .env and fill in your keys.

# Optional. Writes the scripts through the pay-per-use API - https://console.anthropic.com
# Leave it empty to use the Claude Code CLI with your Claude subscription instead
# (install once with: npm install -g @anthropic-ai/claude-code, then run `claude` and log in).
ANTHROPIC_API_KEY=

# Voices - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Free stock footage for the explainer format (only one of these is needed).
# Pixabay: sign up at https://pixabay.com, then your key is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels also works if you already have a key (new Pexels keys are currently paused).
PEXELS_API_KEY=

# Free 3D models for Blender shots - sign up at https://sketchfab.com, then
# Settings > Password & API > API Token
SKETCHFAB_API_TOKEN=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice for the explainer narrator (find voice IDs in the ElevenLabs Voice Library).
# The dialogue characters' voices are set in assets/characters/characters.json.
# NARRATOR_VOICE_ID=cjVigY5qzO86Huf0OWal   (default: Eric - smooth, trustworthy)

# YouTube upload (optional, only for --upload / upload.py) - setup steps are in README.md.
# Defaults: secrets/client_secret.json and secrets/youtube_token.json
# YOUTUBE_CLIENT_SECRET=secrets/client_secret.json
# YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# YOUTUBE_CATEGORY_ID=27   (27 = Education, 28 = Science & Technology)
